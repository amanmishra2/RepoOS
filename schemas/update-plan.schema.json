{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://repoos.dev/schemas/update-plan.schema.json",
  "title": "RepoOS deterministic update plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "plan_id",
    "project_id",
    "base_commit",
    "from_version",
    "to_version",
    "operations",
    "conflicts",
    "limits",
    "dry_run_default"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "plan_id": {"type": "string", "pattern": "^plan-[a-f0-9]{64}$"},
    "project_id": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"},
    "base_commit": {
      "oneOf": [
        {"type": "string", "pattern": "^[a-f0-9]{40,64}$"},
        {"type": "null"}
      ]
    },
    "from_version": {
      "oneOf": [
        {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$"},
        {"type": "null"}
      ]
    },
    "to_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$"
    },
    "operations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "action",
          "source",
          "target",
          "source_sha256",
          "before_sha256",
          "size_bytes"
        ],
        "properties": {
          "action": {"enum": ["create", "replace", "delete"]},
          "source": {
            "oneOf": [
              {
                "type": "string",
                "minLength": 1,
                "not": {"pattern": "(^/|(^|/)\\.\\.(/|$)|\\\\)"}
              },
              {"type": "null"}
            ]
          },
          "target": {
            "type": "string",
            "minLength": 1,
            "not": {"pattern": "(^/|(^|/)\\.\\.(/|$)|\\\\)"}
          },
          "source_sha256": {
            "oneOf": [
              {"type": "string", "pattern": "^[a-f0-9]{64}$"},
              {"type": "null"}
            ]
          },
          "before_sha256": {
            "oneOf": [
              {"type": "string", "pattern": "^[a-f0-9]{64}$"},
              {"type": "null"}
            ]
          },
          "size_bytes": {"type": "integer", "minimum": 0}
        }
      }
    },
    "conflicts": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_files", "max_bytes"],
      "properties": {
        "max_files": {"type": "integer", "minimum": 1, "maximum": 1000},
        "max_bytes": {"type": "integer", "minimum": 1}
      }
    },
    "dry_run_default": {"const": true}
  }
}
