{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://repoos.dev/schemas/adoption-record.schema.json",
  "title": "RepoOS adoption record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "adoption_id",
    "project_alias",
    "component",
    "version",
    "channel",
    "state",
    "decision",
    "approved_by",
    "evidence_refs"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "adoption_id": {"type": "string", "pattern": "^ADP-[0-9]{8}-[a-f0-9]{8}$"},
    "project_alias": {"type": "string", "pattern": "^[A-Za-z0-9-]+$"},
    "component": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"},
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$"
    },
    "channel": {"enum": ["experimental", "canary", "stable", "required"]},
    "state": {"enum": ["proposed", "adopted", "deferred", "excluded", "rolled_back"]},
    "decision": {"type": "string", "minLength": 1},
    "approved_by": {"type": ["string", "null"]},
    "evidence_refs": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "minItems": 1,
      "uniqueItems": true
    }
  }
}
